
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BlockWorld</title>
<style>
body{margin:0;overflow:hidden;font-family:Arial}
#hud{position:fixed;top:12px;left:12px;color:white;
background:#17212bcc;padding:12px;border-radius:10px;z-index:2}
#hotbar{position:fixed;bottom:18px;left:50%;
transform:translateX(-50%);display:flex;gap:5px;z-index:2}
.slot{width:43px;height:43px;background:#333d;
border:2px solid white;color:white;display:grid;
place-items:center;font-size:22px}
#admin{display:none;position:fixed;right:12px;top:12px;
background:#17212b;color:white;padding:15px;
border:3px solid gold;border-radius:12px;z-index:4}
button{padding:9px;margin:4px}
#help{position:fixed;bottom:75px;left:12px;color:white;
background:#222b;padding:8px;z-index:2}
</style>
</head>
<body>
<div id="hud">
<b>🌍 BLOCKWORLD</b><br>
❤️ Health: <span id="health">10</span>/10<br>
🍗 Hunger: <span id="hunger">10</span>/10<br>
🧱 Blocks: <span id="count">64</span><br>
👑 Owner: Elia
</div>

<div id="help">
WASD: Move | SPACE: Jump<br>
Mouse: Look | Click: Mine<br>
Right click: Build | O: Owner panel
</div>

<div id="hotbar">
<div class="slot">🟩</div><div class="slot">🟫</div>
<div class="slot">🪨</div><div class="slot">🪵</div>
<div class="slot">🌳</div><div class="slot">🟦</div>
<div class="slot">🟨</div><div class="slot">🟥</div>
<div class="slot">⬜</div>
</div>

<div id="admin">
<h2>👑 OWNER PANEL</h2>
<button onclick="fly=!fly">Toggle Fly</button>
<button onclick="infinite=!infinite">Infinite Blocks</button>
<button onclick="blocks=999999;updateHUD()">Give Blocks</button>
<button onclick="health=10;hunger=10;updateHUD()">Restore Stats</button>
<button onclick="document.getElementById('admin').style.display='none'">Close</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>
const OWNER="elialendorfer-byte";
const player={username:OWNER};

let fly=false,infinite=false,blocks=64;
let health=10,hunger=10;

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x87ceeb);
scene.fog=new THREE.Fog(0x87ceeb,25,100);

const camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.1,1000);
const renderer=new THREE.WebGLRenderer({antialias:false});
renderer.setSize(innerWidth,innerHeight);
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x667744,2));
const sun=new THREE.DirectionalLight(0xffffff,2);
sun.position.set(10,20,10);scene.add(sun);

const colors=[0x55aa33,0x80603c,0x888888,0x3366aa,0xcccccc];
const materials=colors.map(c=>new THREE.MeshLambertMaterial({color:c}));
const geometry=new THREE.BoxGeometry(1,1,1);
const world=[];

function addBlock(x,y,z,type=0){
 const m=new THREE.Mesh(geometry,materials[type]);
 m.position.set(x,y,z);scene.add(m);world.push(m);
}

for(let x=-20;x<=20;x++){
 for(let z=-20;z<=20;z++){
  addBlock(x,0,z,0);
  if(Math.random()<.025){
   for(let y=1;y<=3;y++)addBlock(x,y,z,1);
   for(let dx=-1;dx<=1;dx++)
    for(let dz=-1;dz<=1;dz++)
     addBlock(x+dx,4,z+dz,0);
  }
 }
}

// Cabin
for(let x=-3;x<=3;x++){
 for(let z=-3;z<=3;z++){
  if(x===-3||x===3||z===-3||z===3){
   addBlock(x,1,z,1);addBlock(x,2,z,1);
  }
 }
}
for(let x=-3;x<=3;x++)for(let z=-3;z<=3;z++)addBlock(x,3,z,1);

const pos=new THREE.Vector3(0,2,6);
let yaw=0,pitch=0,vy=0,onGround=false;
const keys={};

document.addEventListener("keydown",e=>{
 keys[e.key.toLowerCase()]=true;
 if(e.key.toLowerCase()==="o" && player.username===OWNER){
  const p=document.getElementById("admin");
  p.style.display=p.style.display==="none"?"block":"none";
 }
 if(e.key.toLowerCase()==="f" && player.username===OWNER)fly=!fly;
});
document.addEventListener("keyup",e=>keys[e.key.toLowerCase()]=false);

renderer.domElement.addEventListener("click",()=>{
 renderer.domElement.requestPointerLock();
});
document.addEventListener("mousemove",e=>{
 if(document.pointerLockElement===renderer.domElement){
  yaw-=e.movementX*.002;
  pitch-=e.movementY*.002;
  pitch=Math.max(-1.5,Math.min(1.5,pitch));
 }
});

function hitBlock(){
 const ray=new THREE.Raycaster();
 ray.setFromCamera(new THREE.Vector2(0,0),camera);
 return ray.intersectObjects(world)[0];
}
document.addEventListener("mousedown",e=>{
 if(document.pointerLockElement!==renderer.domElement)return;
 const hit=hitBlock();if(!hit)return;
 if(e.button===0){
  scene.remove(hit.object);
  world.splice(world.indexOf(hit.object),1);
  if(!infinite)blocks++;
 }
 if(e.button===2 && (infinite||blocks>0)){
  const p=hit.object.position.clone().add(hit.face.normal);
  addBlock(Math.round(p.x),Math.round(p.y),Math.round(p.z),1);
  if(!infinite)blocks--;
 }
 updateHUD();
});
document.addEventListener("contextmenu",e=>e.preventDefault());

function updateHUD(){
 document.getElementById("count").textContent=infinite?"∞":blocks;
 document.getElementById("health").textContent=health;
 document.getElementById("hunger").textContent=hunger;
}

function animate(){
 requestAnimationFrame(animate);
 const forward=new THREE.Vector3(-Math.sin(yaw),0,-Math.cos(yaw));
 const right=new THREE.Vector3(Math.cos(yaw),0,-Math.sin(yaw));
 const speed=.13;
 if(keys.w||keys.arrowup)pos.addScaledVector(forward,speed);
 if(keys.s||keys.arrowdown)pos.addScaledVector(forward,-speed);
 if(keys.a||keys.arrowleft)pos.addScaledVector(right,-speed);
 if(keys.d||keys.arrowright)pos.addScaledVector(right,speed);

 if(fly){
  if(keys.space)pos.y+=speed;
  if(keys.shift)pos.y-=speed;
 }else{
  if(keys.space&&onGround){vy=.18;onGround=false}
  vy-=.009;pos.y+=vy;
  if(pos.y<2){pos.y=2;vy=0;onGround=true}
 }
 camera.position.copy(pos);
 camera.rotation.order="YXZ";
 camera.rotation.y=yaw;camera.rotation.x=pitch;
 renderer.render(scene,camera);
}
animate();

window.addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
updateHUD();
</script>
</body>
</html>
